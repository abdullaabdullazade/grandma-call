# copy to deploy/.env on the server
ADMIN_PASSWORD=change-me-long-random
ADMIN_PATH=random-32-hex-chars          # admin panel lives at https://<domain>/<ADMIN_PATH>/
DL_PATH=random-16-hex-chars             # public APK link: https://<domain>/d/<DL_PATH>/call.apk
JOIN_CODE=123456                        # first group's join code (more groups in the admin panel)
TURN_SECRET=random-hex
TURN_URLS=turn:<server-ip>:3478?transport=udp,turn:<server-ip>:3478?transport=tcp
TURN_EXTERNAL_IP=<server-ip>
TURN_REALM=call.example.com
