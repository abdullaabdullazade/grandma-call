<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/green" android:elevation="4dp" android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:gravity="center_vertical" android:paddingLeft="16dp" android:paddingRight="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/app_name" android:textColor="@android:color/white"
                android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/me" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF" android:textSize="14sp" />
            <TextView android:id="@+id/lang" android:layout_width="wrap_content" android:layout_height="32dp"
                android:layout_marginStart="12dp" android:background="?android:attr/selectableItemBackground"
                android:gravity="center" android:paddingLeft="10dp" android:paddingRight="10dp" android:text="@string/lang_switch"
                android:textColor="@android:color/white" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp">
            <TextView android:id="@+id/tabContacts" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:text="@string/tab_contacts"
                android:textColor="@android:color/white" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/tabCalls" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:text="@string/tab_calls"
                android:textColor="@android:color/white" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
        <View android:id="@+id/indicator" android:layout_width="0dp" android:layout_height="3dp"
            android:background="@android:color/white" />
    </LinearLayout>

    <TextView android:id="@+id/updateBar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/green_light" android:gravity="center" android:padding="12dp"
        android:textColor="@android:color/white" android:textSize="15sp" android:textStyle="bold" android:visibility="gone" />

    <TextView android:id="@+id/alertBar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/red" android:gravity="center" android:padding="14dp" android:text="@string/alerts_off"
        android:textColor="@android:color/white" android:textSize="15sp" android:textStyle="bold" android:visibility="gone" />

    <TextView android:id="@+id/oemBar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#FFFFF3C4" android:gravity="center" android:padding="12dp" android:text="@string/oem_hint"
        android:textColor="#FF54656F" android:textSize="15sp" android:visibility="gone" />

    <TextView android:id="@+id/banner" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#FFFFF3C4" android:gravity="center" android:padding="8dp"
        android:textColor="#FF54656F" android:textSize="14sp" android:visibility="gone" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@null" />
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:padding="32dp" android:textColor="@color/muted" android:textSize="16sp" />
    </FrameLayout>
</LinearLayout>
