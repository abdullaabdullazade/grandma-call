<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="76dp"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="8dp">

    <TextView android:id="@+id/avatar" android:layout_width="52dp" android:layout_height="52dp"
        android:gravity="center" android:textColor="@android:color/white" android:textSize="22sp" android:textStyle="bold" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="16dp" android:orientation="vertical">
        <TextView android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:ellipsize="end" android:singleLine="true" android:textColor="@color/text" android:textSize="18sp" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:gravity="center_vertical">
            <ImageView android:id="@+id/dir" android:layout_width="16dp" android:layout_height="16dp"
                android:layout_marginEnd="4dp" />
            <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:singleLine="true" android:textColor="@color/muted" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton android:id="@+id/again" android:layout_width="48dp" android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="12dp"
        android:scaleType="fitCenter" android:tint="@color/green_light" />
</LinearLayout>
